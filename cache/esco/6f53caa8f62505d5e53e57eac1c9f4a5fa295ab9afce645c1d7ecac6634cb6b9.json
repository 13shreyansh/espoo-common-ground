      "es": {
        "literal": "Aplicar los sistemas y modelos de bases de datos, definir las dependencias de datos, utilice los lenguajes de consulta y los sistemas de gestión de bases de datos (DBMS) para desarrollar y gestionar las bases de datos.",
        "mimetype": "plain/text"
