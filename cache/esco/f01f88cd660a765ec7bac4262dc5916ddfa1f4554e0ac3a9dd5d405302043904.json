      },
      "hu": {
        "literal": "A szoftverfejlesztés technikái és alapelvei, úgymint elemzés, algoritmusok, kódolás, tesztelés és a programozási paradigmák összeállítása JavaScriptben.",
        "mimetype": "plain/text"
      },
      "sk": {
